msgid "Output options"
msgstr "Opciones de salida"

#: pymedia/typer_options.py:99
msgid "Output directory for multiple output files."
msgstr "Directorio de salida para varios archivos de salida."

#: pymedia/typer_options.py:109
msgid "Output file name."
msgstr "Nombre del archivo de salida."

#: pymedia/typer_options.py:119
msgid "Action to use if output file already exists."
msgstr "Acción a usar si el archivo de salida ya existe."

#: pymedia/typer_options.py:133 pymedia/typer_options.py:143
#: pymedia/typer_options.py:155 pymedia/typer_options.py:166
#: pymedia/typer_options.py:176 pymedia/typer_options.py:187
#: pymedia/typer_options.py:198 pymedia/typer_options.py:209
msgid "Command options"
msgstr "Opciones de comando"

#: pymedia/typer_options.py:134
msgid "Interval between thumbnails, in seconds."
msgstr "Intervalo entre miniaturas, en segundos."

#: pymedia/typer_options.py:144
msgid "Preset sheet style."
msgstr "Estilo de hoja preestablecido."

#: pymedia/typer_options.py:156
msgid "Scene-change sensitivity for thumbnail detection."
msgstr "Sensibilidad de cambio de escena para la detección de miniaturas."

#: pymedia/typer_options.py:167
msgid "Take a thumbnail at specific TIMESTAMP(s)."
msgstr "Toma una miniatura en TIMESTAMP(s) específicos."

#: pymedia/typer_options.py:177
msgid "Time point at which GIF generation ends."
msgstr "Punto temporal en que termina la generación del GIF."

#: pymedia/typer_options.py:188
msgid "Time point at which thumbnails generation ends."
msgstr "Punto de tiempo en el que termina la generación de miniaturas."

#: pymedia/typer_options.py:199
msgid "Time point at which GIF generation starts."
msgstr "Punto temporal en que comienza la generación del GIF."

#: pymedia/typer_options.py:210
msgid "Time point at which thumbnails generation starts."
msgstr "Punto de tiempo en el que comienza la generación de miniaturas."

