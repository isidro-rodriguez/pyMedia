#: pymedia/commands/remux/cli.py:26
msgid ""
"Change container and metadata without transcoding.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Change video container:\n"
"    > pymedia remux input.mp4 -o output.mkv\n"
"  Fix faststart moving moov atom at the start \n"
"    > pymedia remux input.mp4 --fast-start -o output.mp4 \n"
"  Fix broken timestamps\n"
"    > pymedia remux input.mp4 --genpts -o output.mkv\n"
"  Sort stream tracks\n"
"    > pymedia remux input.mp4 --sort-tracks -o output.mp4\n"
msgstr ""
"Cambia el contenedor y los metadatos sin transcodificar.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Cambia el contenedor del vídeo:\n"
"    > pymedia remux input.mp4 -o output.mkv\n"
"  Arregla el faststart moviendo el átomo moov al inicio \n"
"    > pymedia remux input.mp4 --fast-start -o output.mp4 \n"
"  Arregla las marcas de tiempo dañadas\n"
"    > pymedia remux input.mp4 --genpts -o output.mkv\n"
"  Ordena las pistas de flujo\n"
"    > pymedia remux input.mp4 --sort-tracks -o output.mp4\n"

#: pymedia/commands/remux/cli.py:77
