#: pymedia/typer/help.py:12
msgid ""
"Add an audio track to a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Add english audio to a media container:\n"
"    > pymedia add-audio input.mp4 eng_audio.aac --language eng\n"
"  Add default commentary spanish audio with custom title: \n"
"    > pymedia add-audio input.mp4 spa_audio.aac --language spa --title "
"\"Comentario director\" --default --commentary\n"
msgstr ""
"Añade una pista de audio a un fichero multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Añadir audio en inglés a un contenedor multimedia:\n"
"    > pymedia add-audio input.mp4 eng_audio.aac --language eng\n"
"  Añadir audio en español por defecto como comentario con título "
"personalizado: \n"
"    > pymedia add-audio input.mp4 spa_audio.aac --language spa --title "
"\"Comentario del director\" --default --commentary\n"

#: pymedia/typer/help.py:25
msgid ""
"Delete audio tracks from a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Delete all audio tracks from a media file:\n"
"    > pymedia delete-audio input.mp4\n"
"  Delete a list of audio tracks from a media file: \n"
"    > pymedia delete-audio input.mp4 --tracks 1,2\n"
msgstr ""
"Elimina pistas de audio de un fichero multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Eliminar todas las pistas de audio de un fichero multimedia:\n"
"    > pymedia delete-audio input.mp4\n"
"  Eliminar una lista de pistas de audio de un fichero multimedia: \n"
"    > pymedia delete-audio input.mp4 --tracks 1,2\n"

#: pymedia/typer/help.py:38
msgid ""
"Edit audio track metadata from a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Edit language metadata of audio stream track 1 from a media container:\n"
"    > pymedia edit-audio input.mp4 --track 1 --language eng\n"
"  Edit multiple tags in a single call: \n"
"    > pymedia edit-audio input.mp4 --track 1 --language spa --title "
"\"Comentario director\" --default --commentary\n"
msgstr ""
"Edita los metadatos de una pista de audio de un fichero multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Editar el idioma de la pista de audio 1 de un contenedor multimedia:\n"
"    > pymedia edit-audio input.mp4 --track 1 --language eng\n"
"  Editar varias etiquetas en una sola llamada: \n"
"    > pymedia edit-audio input.mp4 --track 1 --language spa --title "
"\"Comentario del director\" --default --commentary\n"

#: pymedia/typer/help.py:51
msgid ""
"Extract audio tracks from a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Extract all audio tracks from a media file:\n"
"    > pymedia extract-audio input.mp4\n"
"  Extract a list of audio tracks from a media file: \n"
"    > pymedia extract-audio input.mp4 --tracks 1,2\n"
"  Extract audio tracks with custom output:\n"
"    > pymedia extract-audio input.mp4 --tracks 1,2 -o input-audio.aac\n"
msgstr ""
"Extrae pistas de audio de un fichero multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Extraer todas las pistas de audio de un fichero multimedia:\n"
"    > pymedia extract-audio input.mp4\n"
"  Extraer una lista de pistas de audio de un fichero multimedia: \n"
"    > pymedia extract-audio input.mp4 --tracks 1,2\n"
"  Extraer pistas de audio con una salida personalizada:\n"
"    > pymedia extract-audio input.mp4 --tracks 1,2 -o audio.aac\n"

#: pymedia/typer/help.py:66
msgid ""
"Generates an animated image from the specified video.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Convert a video to GIF:\n"
"    > pymedia gif input.mp4\n"
"  Convert a time range:\n"
"    > pymedia gif input.mp4 --start 00:00:05 --end 00:00:12\n"
"  Set size and frame rate:\n"
"    > pymedia gif input.mp4 --size 480x270 --fps 15\n"
"  Save to a specific file:\n"
"    > pymedia gif input.mp4 --output output.gif\n"
msgstr ""
"Genera una imagen animada a partir del vídeo especificado.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Convertir un vídeo a GIF:\n"
"    > pymedia gif input.mp4\n"
"  Convertir un rango de tiempo:\n"
"    > pymedia gif input.mp4 --start 00:00:05 --end 00:00:12\n"
"  Establecer tamaño y frecuencia de imagen:\n"
"    > pymedia gif input.mp4 --size 480x270 --fps 15\n"
"  Guardar en un fichero concreto:\n"
"    > pymedia gif input.mp4 --output output.gif\n"

#: pymedia/typer/help.py:81
msgid ""
"Shows information about a video.\n"
"\n"
"[bold]Example[/bold]:\n"
"  Shows video's metadata:\n"
"    > pymedia info input.mp4\n"
msgstr ""
"Muestra información sobre un vídeo.\n"
"\n"
"[bold]Ejemplo[/bold]:\n"
"  Muestra los metadatos del vídeo:\n"
"    > pymedia info input.mp4\n"

#: pymedia/typer/help.py:92
msgid ""
"Easy CLI for ffmpeg.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Generate an animated GIF from a video:   \n"
"    > pymedia gif input.mp4\n"
"  Print GIF's help:     \n"
"    > pymedia gif --help\n"
msgstr ""
"CLI sencilla para ffmpeg.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Genera un GIF animado a partir de un vídeo:   \n"
"    > pymedia gif input.mp4\n"
"  Muestra la ayuda del comando GIF:     \n"
"    > pymedia gif --help\n"

#: pymedia/typer/help.py:105
msgid ""
"Generates a thumbnail grid sheet with media info header.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Generate a vcs with default HD preset:\n"
"    > pymedia sheet input.mp4\n"
"  Generates a vcs with different preset and specified output:\n"
"    > pymedia sheet input.mp4 --preset fhd -o vcs.webp\n"
msgstr ""
"Genera una hoja de miniaturas con cabecera de información del medio.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Genera una hoja con el preajuste HD por defecto:\n"
"    > pymedia sheet input.mp4\n"
"  Genera una hoja con otro preajuste y salida indicada:\n"
"    > pymedia sheet input.mp4 --preset fhd -o vcs.webp\n"

#: pymedia/typer/help.py:118
msgid ""
"Add subtitles to a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Add english subtitles to a media container:\n"
"    > pymedia add-subs input.mp4 eng_subs.srt --language eng\n"
"  Add default forced spanish subtitles with custom title: \n"
"    > pymedia add-subs input.mp4 eng_subs.srt --language spa --title "
"\"Español (forced)\" --default --forced\n"
msgstr ""
"Añade subtítulos a un archivo multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Añade subtítulos en inglés a un contenedor multimedia:\n"
"    > pymedia add-subs input.mp4 eng_subs.srt --language eng\n"
"  Añade subtítulos en español forzados y predeterminados con título "
"personalizado: \n"
"    > pymedia add-subs input.mp4 eng_subs.srt --language spa --title "
"\"Español (forced)\" --default --forced\n"

#: pymedia/typer/help.py:131
msgid ""
"Delete subtitles from a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Delete all subtitles from a media file:\n"
"    > pymedia delete-subs input.mp4\n"
"  Delete a list of subtitles tracks from a media file: \n"
"    > pymedia delete-subs input.mp4 --tracks 3,4,5\n"
msgstr ""
"Elimina subtítulos de un archivo multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Elimina todos los subtítulos de un archivo multimedia:\n"
"    > pymedia delete-subs input.mp4\n"
"  Elimina una lista de pistas de subtítulos de un archivo multimedia: \n"
"    > pymedia delete-subs input.mp4 --tracks 3,4,5\n"

#: pymedia/typer/help.py:144
msgid ""
"Edit subtitles metadata from a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Edit language metadata to subtitles stream track 2 from a media "
"container:\n"
"    > pymedia edit-subs input.mp4 --track 2 --language eng\n"
"  Edit multiple tags in a single call: \n"
"    > pymedia edit-subs input.mp4 --track 2 --language spa --title "
"\"Español (forced)\" --default --forced\n"
msgstr ""
"Edita los metadatos de los subtítulos de un archivo multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Edita el idioma de la pista 2 de subtítulos de un contenedor "
"multimedia:\n"
"    > pymedia edit-subs input.mp4 --track 2 --language eng\n"
"  Edita varias etiquetas en una sola llamada: \n"
"    > pymedia edit-subs input.mp4 --track 2 --language spa --title "
"\"Español (forced)\" --default --forced\n"

#: pymedia/typer/help.py:157
msgid ""
"Extract subtitles from a media file.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Extract all subtitles from a media file:\n"
"    > pymedia extract-subs input.mp4\n"
"  Extract a list of subtitles tracks from a media file: \n"
"    > pymedia extract-subs input.mp4 --tracks 3,4,5\n"
"  Extract subtitles tracks with custom output:\n"
"    > pymedia extract-subs input.mp4 --tracks 3,5 -o input-subtitles.srt\n"
msgstr ""
"Extrae subtítulos de un archivo multimedia.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Extrae todos los subtítulos de un archivo multimedia:\n"
"    > pymedia extract-subs input.mp4\n"
"  Extrae una lista de pistas de subtítulos de un archivo multimedia: \n"
"    > pymedia extract-subs input.mp4 --tracks 3,4,5\n"
"  Extrae pistas de subtítulos con salida personalizada:\n"
"    > pymedia extract-subs input.mp4 --tracks 3,5 -o input-subtitles.srt\n"

#: pymedia/typer/help.py:171
msgid ""
"Captures thumbnails at the specified timestamps.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Capture a single thumbnail at a given time:\n"
"    > pymedia frames input.mp4 --at 00:01:30\n"
"  Capture thumbnails at several timestamps:\n"
"    > pymedia frames input.mp4 --at 00:01:30,00:05:15\n"
"  Save to a specific file:\n"
"    > pymedia frames input.mp4 --at 00:01:30 --output thumb.jpg\n"
msgstr ""
"Captura miniaturas en las marcas de tiempo indicadas.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Captura una miniatura en un instante concreto:\n"
"    > pymedia frames input.mp4 --at 00:01:30\n"
"  Captura miniaturas en varias marcas de tiempo:\n"
"    > pymedia frames input.mp4 --at 00:01:30,00:05:15\n"
"  Guarda en un fichero concreto:\n"
"    > pymedia frames input.mp4 --at 00:01:30 --output thumb.jpg\n"

#: pymedia/typer/help.py:186
msgid ""
"Captures thumbnails at regular intervals of the video.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Capture a thumbnail every second:\n"
"    > pymedia interval input.mp4 --every 1\n"
"  Capture a thumbnail every 5 seconds within a time range:\n"
"    > pymedia interval input.mp4 --every 5 --start 00:00:10 --end "
"00:01:00\n"
"  Save to a specific file:\n"
"    > pymedia interval input.mp4 --every 5 --output thumb.jpg\n"
msgstr ""
"Captura miniaturas a intervalos regulares del vídeo.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Captura una miniatura cada segundo:\n"
"    > pymedia interval input.mp4 --every 1\n"
"  Captura una miniatura cada 5 segundos dentro de un rango de tiempo:\n"
"    > pymedia interval input.mp4 --every 5 --start 00:00:10 --end "
"00:01:00\n"
"  Guarda en un fichero concreto:\n"
"    > pymedia interval input.mp4 --every 5 --output thumb.jpg\n"

#: pymedia/typer/help.py:201
msgid ""
"Captures thumbnails at the scene changes detected in the video.\n"
"\n"
"[bold]Examples[/bold]:\n"
"  Detect scene changes with default sensitivity:\n"
"    > pymedia scene input.mp4\n"
"  Adjust the scene-change sensitivity:\n"
"    > pymedia scene input.mp4 --scene 0.3\n"
"  Limit the search to a time range:\n"
"    > pymedia scene input.mp4 --start 00:00:05 --end 00:00:30\n"
"  Save to a specific file:\n"
"    > pymedia scene input.mp4 --output thumb.jpg\n"
msgstr ""
"Captura miniaturas en los cambios de escena detectados en el vídeo.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"  Detecta cambios de escena con la sensibilidad por defecto:\n"
"    > pymedia scene input.mp4\n"
"  Ajusta la sensibilidad de detección de escena:\n"
"    > pymedia scene input.mp4 --scene 0.3\n"
"  Limita la búsqueda a un rango de tiempo:\n"
"    > pymedia scene input.mp4 --start 00:00:05 --end 00:00:30\n"
"  Guarda en un fichero concreto:\n"
"    > pymedia scene input.mp4 --output thumb.jpg\n"

#: pymedia/typer/help.py:217
msgid ""
"Transcode video container changing its codecs and compression.\n"
"\n"
"You can edit preset profiles in config.toml.\n"
"\n"
"[bold]Examples[/bold]:\n"
"    Transcode only video track changing with a configurated profile:\n"
"    > pymedia transcode source.mp4 --profile balanced --video -o "
"target.mp4\n"
"    Transcode video and audio track 1 changing its codecs with a "
"configurated profile:\n"
"    > pymedia transcode source.mp4 --profile slow --video --audio 1 -o "
"target.mp4\n"
"    Transcode video track meanwhile its applied multiple filters: \n"
"    > pymedia transcode source.mp4 --profile fast --size 1280x720 --hflip"
"\n"
msgstr ""
"Transcodifica el contenedor de vídeo cambiando sus códecs y compresión.\n"
"\n"
"Puedes editar los perfiles de presets en config.toml.\n"
"\n"
"[bold]Ejemplos[/bold]:\n"
"    Transcodificar solo la pista de vídeo cambiando con un perfil "
"configurado:\n"
"    > pymedia transcode source.mp4 --profile balanced --video -o "
"target.mp4\n"
"    Transcodificar vídeo y pista de audio 1 cambiando sus códecs con un "
"perfil configurado:\n"
"    > pymedia transcode source.mp4 --profile slow --video --audio 1 -o "
"target.mp4\n"
"    Transcodificar la pista de vídeo mientras se aplican varios filtros:"
" \n"
"    > pymedia transcode source.mp4 --profile fast --size 1280x720 --hflip"
"\n"

