#: pymedia/errors.py:45
#, python-format
msgid "Could not create directory: %(path)s"
msgstr "No se pudo crear el directorio: %(path)s"

#: pymedia/errors.py:52
#, python-format
msgid "FFmpeg command %(command_name)s failed during execution. Error: %(error)s"
msgstr ""
"El comando FFmpeg %(command_name)s falló durante la ejecución. Error: "
"%(error)s"

#: pymedia/errors.py:62
#, python-format
msgid "FFmpeg command %(command_name)s was not generated."
msgstr "El comando FFmpeg %(command_name)s no se generó."

#: pymedia/errors.py:70
#, python-format
msgid "FFmpeg command %(command_name)s timed out."
msgstr "El comando FFmpeg %(command_name)s agotó el tiempo de espera."

#: pymedia/errors.py:77
#, python-format
msgid "Invalid configuration: %(message)s"
msgstr "Configuración no válida: %(message)s"

#: pymedia/errors.py:95
msgid ""
"It is not allowed to specify an output with multiple inputs, use output "
"directory instead."
msgstr ""
"No se permite especificar una salida con varias entradas; usa el "
"directorio de salida en su lugar."

#: pymedia/errors.py:104
msgid "It is not allowed to specify an output path and an output directory."
msgstr ""
"No se permite especificar una ruta de salida y un directorio de salida a "
"la vez."

#: pymedia/errors.py:110
msgid "It is not allowed to specify width and height together."
msgstr "No se permite especificar anchura y altura a la vez."

#: pymedia/errors.py:115
#, python-format
msgid "Missing argument: %(argument)s"
msgstr "Falta el argumento: %(argument)s"

#: pymedia/errors.py:120
#, python-format
msgid "Missing media information: %(path)s"
msgstr "Falta información de vídeo: %(path)s"

#: pymedia/errors.py:125
#, python-format
msgid "Missing media property: %(name)s"
msgstr "Falta la propiedad del vídeo: %(name)s"

#: pymedia/errors.py:130
#, python-format
msgid "Missing name: %(name)s"
msgstr "Falta el parámetro: %(name)s"

#: pymedia/errors.py:137
msgid ""
"It is not allowed to specify an output if it has been provided multiple "
"video inputs."
msgstr ""
"No se permite especificar una salida si se han proporcionado varias "
"entradas de vídeo."

#: pymedia/errors.py:158
#, python-format
msgid ""
"Invalid crop dimensions: %(crop_dimensions)s >= original "
"%(video_dimensions)s."
msgstr ""
"Dimensiones de recorte no válidas: %(crop_dimensions)s >= original "
"%(video_dimensions)s."

#: pymedia/errors.py:167
msgid "Invalid borders format. Expected: LEFT,RIGHT,TOP,BOTTOM."
msgstr ""
"Formato de bordes no válido. Esperado: "
"IZQUIERDA,DERECHA,SUPERIOR,INFERIOR."

#: pymedia/errors.py:172
msgid "Invalid crop format. Expected: WIDTH,HEIGHT,X,Y."
msgstr "Formato de recorte no válido. Esperado: ANCHO,ALTO,X,Y."

#: pymedia/errors.py:178
#, python-format
msgid "%(directory)s contains invalid characters: < > : \" / \\ | ? *"
msgstr "%(directory)s contiene caracteres no válidos: < > : \" / \\ | ? *"

#: pymedia/errors.py:186
#, python-format
msgid "%(filename)s contains invalid characters: < > : \" / \\ | ? *"
msgstr "%(filename)s contiene caracteres no válidos: < > : \" / \\ | ? *"

#: pymedia/errors.py:195
#, python-format
msgid ""
"Invalid extension %(extension)s. Codec %(codec)s requires one of: "
"%(supported)s."
msgstr ""
"Extensión %(extension)s no válida. El códec %(codec)s requiere una de: "
"%(supported)s."

#: pymedia/errors.py:206
#, python-format
msgid ""
"Invalid extension %(extension)s. %(media_type)s requires one of: "
"%(supported)s."
msgstr ""
"Extensión %(extension)s no válida. %(media_type)s requiere una de: "
"%(supported)s."

#: pymedia/errors.py:219
msgid "Invalid timestamp format. Expected: hh:mm:ss."
msgstr "Formato de marca de tiempo no válido. Esperado: hh:mm:ss."

#: pymedia/errors.py:225
#, python-format
msgid "Timestamp %(time)s exceeds video duration %(duration)s."
msgstr "La marca de tiempo %(time)s supera la duración del vídeo %(duration)s."

