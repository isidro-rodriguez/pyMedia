"Establece un título personalizado de la pista de audio para el "
"reproductor."

#: pymedia/typer/options.py:349 pymedia/typer/options.py:358
#: pymedia/typer/options.py:367 pymedia/typer/options.py:376
#: pymedia/typer/options.py:386 pymedia/typer/options.py:396
#: pymedia/typer/options.py:405 pymedia/typer/options.py:414
msgid "Subtitles options"
msgstr "Opciones de subtítulos"

#: pymedia/typer/options.py:350
msgid "Set as default subtitles of the container."
msgstr "Establecer como subtítulo predeterminado del contenedor."

#: pymedia/typer/options.py:368
msgid "Set as targeted for hearing impaired people."
msgstr "Establecer como dirigido a personas con discapacidad auditiva."

#: pymedia/typer/options.py:377
msgid "Set subtitles language, formatted as ISO 639-2 code."
msgstr "Establece el idioma de los subtítulos, con formato de código ISO 639-2."

#: pymedia/typer/options.py:387
msgid "List subtitles tracks to delete."
msgstr "Lista de pistas de subtítulos a eliminar."

#: pymedia/typer/options.py:397
msgid "Subtitles track to edit."
msgstr "Pista de subtítulos a editar."

#: pymedia/typer/options.py:406
msgid "Set a custom title for video player."
msgstr "Establece un título personalizado para el reproductor de vídeo."

#: pymedia/typer/options.py:415
msgid "Set as targeted for visual impaired people."
msgstr "Establecer como dirigido a personas con discapacidad visual."

#: pymedia/typer/options.py:428 pymedia/typer/options.py:437
#: pymedia/typer/options.py:446 pymedia/typer/options.py:457
#: pymedia/typer/options.py:466
msgid "Filter options"
msgstr "Opciones de filtro"

#: pymedia/typer/options.py:429
msgid "Crop to WIDTH×HEIGHT at offset X,Y (from top-left)."
msgstr ""
"Recorta a ANCHO×ALTO en el desplazamiento X,Y (desde la esquina superior "
"izquierda)."

#: pymedia/typer/options.py:438
msgid "Flip the image horizontally, swapping left and right."
msgstr "Invierte la imagen horizontalmente, intercambiando izquierda y derecha."

#: pymedia/typer/options.py:447
msgid "Flip the image vertically, swapping top and bottom."
msgstr "Invierte la imagen verticalmente, intercambiando arriba y abajo."

#: pymedia/typer/options.py:458
msgid "Set the animated image frame rate in frames per second."
msgstr ""
"Establece la velocidad de fotogramas de la imagen animada en fotogramas "
"por segundo."

#: pymedia/typer/options.py:467
msgid "Specify an orthogonal arc degree to rotate the image."
msgstr "Especifica un ángulo de giro ortogonal para rotar la imagen."

#: pymedia/typer/options.py:479 pymedia/typer/options.py:489
#: pymedia/typer/options.py:498
msgid "Scale filter options"
msgstr "Opciones de filtro de escala"

#: pymedia/typer/options.py:480
msgid "Specify different ways to scale the video."
msgstr "Especifica distintas formas de escalar el vídeo."

#: pymedia/typer/options.py:490
msgid "Target resolution, in pixels, to resize the video."
msgstr "Resolución objetivo, en píxeles, para redimensionar el vídeo."

#: pymedia/typer/options.py:499
msgid "Allows upscaling beyond the source dimensions."
msgstr "Permite ampliar más allá de las dimensiones de origen."

#: pymedia/typer/service.py:43
msgid "The following options are mutually exclusive: output, output_directory"
msgstr "Las siguientes opciones son mutuamente excluyentes: output, output_directory"

#: pymedia/typer/service.py:49
msgid ""
"It is not allowed to specify an output with multiple inputs, use output "
"directory instead."
msgstr ""
"No se permite especificar una salida con varias entradas; usa el "
"directorio de salida en su lugar."

#: pymedia/typer/service.py:68 pymedia/typer/service.py:86
#, python-format
msgid "%(path)s is not a file."
msgstr "%(path)s no es un archivo."

#: pymedia/typer/commands/join_command.py:47
msgid "It's required to provide at least 2 videos."
msgstr "Es necesario proporcionar al menos 2 vídeos."

#: pymedia/typer/commands/remux_command.py:60
msgid "Fast start only works for '.mp4' remux."
msgstr "El modo fast start solo funciona con el remux '.mp4'."

#: pymedia/typer/commands/transcode_command.py:91
msgid ""
"One of the following options is required: transcode_audio, "
"transcode_video, crop, rotate, scale_to, hflip, vflip."
msgstr ""
"Se requiere una de las siguientes opciones: transcode_audio, "
"transcode_video, crop, rotate, scale_to, hflip, vflip."
