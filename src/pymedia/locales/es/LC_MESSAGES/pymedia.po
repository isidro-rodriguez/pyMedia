#: pymedia/models/mixins/crop_mixin.py:64
#, python-format
msgid "Invalid crop %(crop_str)s. Expected: WIDTH,HEIGHT,X,Y"
msgstr "Crop no válido %(crop_str)s. Se esperaba: WIDTH,HEIGHT,X,Y"

#: pymedia/models/mixins/crop_mixin.py:78
msgid "Invalid crop dimensions: width and height must be greater than 0."
msgstr ""
"Dimensiones de recorte no válidas: la anchura y la altura deben ser "
"mayores que 0."

#: pymedia/models/mixins/crop_mixin.py:86
#, python-format
msgid ""
"Invalid crop area. Area width (%(area_width)s) and coordinate X "
"(%(area_x)s) is bigger that video width (%(video_width)s) "
msgstr ""
"Área de recorte no válida. La anchura del área (%(area_width)s) y la "
"coordenada X (%(area_x)s) superan la anchura del vídeo (%(video_width)s)"

#: pymedia/models/mixins/crop_mixin.py:99
#, python-format
msgid ""
"Invalid crop area. Area height (%(area_height)s) and coordinate Y "
"(%(area_y)s) is bigger that video height (%(video_height)s) "
msgstr ""
"Área de recorte no válida. La altura del área (%(area_height)s) y la "
"coordenada Y (%(area_y)s) superan la altura del vídeo (%(video_height)s)"

#: pymedia/models/mixins/flip_mixin.py:27
msgid "Invalid flip name."
msgstr "Parámetro de inversión no válido."

#: pymedia/models/mixins/image_mixin.py:37
msgid "Image container not supported."
msgstr "Contenedor de imagen no soportado."

#: pymedia/models/mixins/outputs_mixin.py:148
msgid ""
"It is not allowed to specify an output with multiple inputs, use output "
"directory instead."
msgstr ""
"No se permite especificar una salida con varias entradas; usa el "
"directorio de salida en su lugar."

#: pymedia/models/mixins/outputs_mixin.py:178
#, python-format
msgid "%(name)s contains invalid characters: < > : \" / \\ | ? *"
msgstr "%(name)s contiene caracteres no válidos: < > : \" / \\ | ? *"

#: pymedia/models/mixins/outputs_mixin.py:190
#, python-format
msgid "Could not create directory: %(path)s"
msgstr "No se pudo crear el directorio: %(path)s"

#: pymedia/models/mixins/scale_mixin.py:94
#, python-format
msgid "Invalid dimensions %(value)s. Expected: WIDTHxHEIGHT"
msgstr "Dimensiones inválidas %(value)s. Se esperaba: WIDTHxHEIGHT"

#: pymedia/models/mixins/scale_mixin.py:102
#: pymedia/models/mixins/scale_mixin.py:118
msgid "video dimensions"
msgstr "dimensiones del vídeo"

#: pymedia/models/mixins/scale_mixin.py:114
msgid "Scale mode not supported."
msgstr "Modo de escala no soportado."

#: pymedia/models/mixins/scale_mixin.py:123
msgid "Target dimensions must be even."
msgstr "Las dimensiones objetivo deben ser pares."

#: pymedia/models/mixins/scale_mixin.py:128
msgid "Ignored scale. Target scale > video resolution, it requires upscale."
msgstr ""
"Escala ignorada. La escala objetivo supera la resolución del vídeo y "
"requiere ampliación."

#: pymedia/models/mixins/timestamps_mixin.py:63
#, python-format
msgid "Invalid timestamps. Start %(timestamp_start)s >= %(time)s."
msgstr "Marcas de tiempo no válidas. Inicio %(timestamp_start)s >= %(time)s."

#: pymedia/models/mixins/timestamps_mixin.py:110
#, python-format
msgid "Invalid timestamps. End %(time)s <= %(timestamp_end)s."
msgstr "Marcas de tiempo no válidas. Fin %(time)s <= %(timestamp_end)s."

#: pymedia/models/mixins/timestamps_mixin.py:143
msgid "Invalidad timestamp list format. Expected hh:mm:ss,hh:mm:ss,..."
msgstr ""
"Formato de lista de marcas de tiempo no válido. Esperado: "
"hh:mm:ss,hh:mm:ss,..."

#: pymedia/models/mixins/timestamps_mixin.py:181
#, python-format
msgid "Timestamp %(time)s exceeds video duration %(duration)s."
msgstr "La marca de tiempo %(time)s supera la duración del vídeo %(duration)s."

