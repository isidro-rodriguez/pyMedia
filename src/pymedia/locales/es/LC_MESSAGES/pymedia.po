msgstr ""
"Ajuste de configuración no válido: se espera que conflictive_concat.fps "
"sea uno de: %(expected)s."

#: pymedia/models/config.py:290
#, python-format
msgid ""
"Invalid configuration setting: conflictive_concat.channels is expected "
"one of: %(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que "
"conflictive_concat.channels sea uno de: %(expected)s."

#: pymedia/models/config.py:303
#, python-format
msgid ""
"Invalid configuration setting: app.language is expected one of: "
"%(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que app.language sea uno de:"
" %(expected)s."

#: pymedia/models/config.py:322
#, python-format
msgid ""
"Invalid configuration setting: encode.default_container is expected one "
"of: %(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que encode.default_container"
