#: pymedia/typer_options.py:234
msgid "Command options"
msgstr "Opciones de comando"

#: pymedia/typer_options.py:135
msgid "Crop to WIDTH×HEIGHT at offset X,Y (from top-left)."
msgstr ""
"Recorta a ANCHO×ALTO en el desplazamiento X,Y (desde la esquina superior "
"izquierda)."

#: pymedia/typer_options.py:144
msgid "Flip the image horizontally, swapping left and right."
msgstr "Invierte la imagen horizontalmente, intercambiando izquierda y derecha."

#: pymedia/typer_options.py:153
msgid "Flip the image vertically, swapping top and bottom."
msgstr "Invierte la imagen verticalmente, intercambiando arriba y abajo."

#: pymedia/typer_options.py:164
msgid "Set the GIF frame rate in frames per second."
msgstr "Establece la frecuencia de fotogramas del GIF en fotogramas por segundo."

#: pymedia/typer_options.py:174
msgid "Preset sheet style."
msgstr "Estilo de hoja preestablecido."

#: pymedia/typer_options.py:183
msgid "Specify an orthogonal arc degree to rotate the image."
msgstr "Especifica un ángulo de giro ortogonal para rotar la imagen."

#: pymedia/typer_options.py:192
msgid "Specify different ways to scale the video."
msgstr "Especifica distintas formas de escalar el vídeo."

#: pymedia/typer_options.py:203
msgid "Target resolution, in pixels, to resize the video."
msgstr "Resolución objetivo, en píxeles, para redimensionar el vídeo."

#: pymedia/typer_options.py:213
msgid "Allows upscaling beyond the source dimensions."
msgstr "Permite ampliar más allá de las dimensiones de origen."

#: pymedia/typer_options.py:224
msgid "Time point at which GIF generation ends."
msgstr "Punto temporal en que termina la generación del GIF."

#: pymedia/typer_options.py:235
msgid "Time point at which GIF generation starts."
msgstr "Punto temporal en que comienza la generación del GIF."

#: pymedia/commands/base_command.py:102
msgid "Output file already exists. Overwrite?"
msgstr "El archivo de salida ya existe. ¿Sobrescribir?"

#: pymedia/commands/base_command.py:238 pymedia/commands/base_command.py:285
msgid "BaseCommand skipped since output file already exists."
msgstr "Comando omitido porque el archivo de salida ya existe."

#: pymedia/commands/gif_command.py:32
msgid "Generates an animated GIF from the specified video."
msgstr "Genera un GIF animado a partir del vídeo indicado"

