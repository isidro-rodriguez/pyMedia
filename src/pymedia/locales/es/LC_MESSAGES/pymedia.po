#: pymedia/models/config.py:196
#, python-format
msgid ""
"Invalid configuration setting: encode.video_codec is expected one of: "
"%(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que encode.video_codec sea "
"uno de: %(expected)s."

#: pymedia/models/config.py:210
#, python-format
msgid ""
"Invalid configuration setting: encode.video_preset is expected one of: "
"%(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que encode.video_preset sea "
"uno de: %(expected)s."

#: pymedia/models/config.py:224
#, python-format
msgid ""
"Invalid configuration setting: encode.video_crf is expected between "
"%(min)s and %(max)s."
msgstr ""
"Ajuste de configuración no válido: se espera que encode.video_crf esté "
"entre %(min)s y %(max)s."

#: pymedia/models/config.py:237
#, python-format
msgid ""
"Invalid configuration setting: encode.audio_codec is expected one of: "
"%(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que encode.audio_codec sea "
"uno de: %(expected)s."

#: pymedia/models/config.py:251
#, python-format
msgid ""
"Invalid configuration setting: encode.audio_bit_rate is expected one of: "
"%(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que encode.audio_bit_rate "
"sea uno de: %(expected)s."

#: pymedia/models/config.py:264
#, python-format
msgid ""
"Invalid configuration setting: conflictive_concat.height is expected one "
"of: %(expected)s."
msgstr ""
"Ajuste de configuración no válido: se espera que "
"conflictive_concat.height sea uno de: %(expected)s."

#: pymedia/models/config.py:277
#, python-format
msgid ""
"Invalid configuration setting: conflictive_concat.fps is expected one of:"
