#: pymedia/errors.py:45
#, python-format
msgid "Could not create directory: %(path)s"
msgstr "No se pudo crear el directorio: %(path)s"

#: pymedia/errors.py:51
#, python-format
msgid "FFmpeg command %(name)s failed during execution. Error: %(error)s"
msgstr "El comando FFmpeg %(name)s falló durante la ejecución. Error: %(error)s"

#: pymedia/errors.py:59
#, python-format
msgid "FFmpeg command %(name)s was not generated."
msgstr "El comando FFmpeg %(name)s no se generó."

#: pymedia/errors.py:65
#, python-format
msgid "FFmpeg command %(name)s timed out."
msgstr "El comando FFmpeg %(name)s agotó el tiempo de espera."

#: pymedia/errors.py:70
#, python-format
msgid "Invalid configuration: %(msg)s"
msgstr "Configuración no válida: %(msg)s"

#: pymedia/errors.py:88
msgid ""
"It is not allowed to specify an output with multiple inputs, use output "
"directory instead."
msgstr ""
"No se permite especificar una salida con varias entradas; usa el "
"directorio de salida en su lugar."

#: pymedia/errors.py:97
msgid "It is not allowed to specify an output path and an output directory."
msgstr ""
"No se permite especificar una ruta de salida y un directorio de salida a "
"la vez."

#: pymedia/errors.py:103
msgid "It is not allowed to specify width and height together."
msgstr "No se permite especificar anchura y altura a la vez."

#: pymedia/errors.py:108
#, python-format
msgid "Missing media information: %(path)s"
msgstr "Falta información de vídeo: %(path)s"

#: pymedia/errors.py:113
#, python-format
msgid "Missing media name: %(name)s"
msgstr "Falta la propiedad del vídeo: %(name)s"

#: pymedia/errors.py:118
#, python-format
msgid "Missing name: %(name)s"
msgstr "Falta el parámetro: %(name)s"

#: pymedia/errors.py:145
#, python-format
msgid "%(filename)s contains invalid characters: < > : \" / \\ | ? *"
msgstr "%(filename)s contiene caracteres no válidos: < > : \" / \\ | ? *"

#: pymedia/errors.py:154
#, python-format
msgid ""
"Invalid extension %(extension)s. Codec %(codec)s requires one of: "
"%(supported)s."
msgstr ""
"Extensión %(extension)s no válida. El códec %(codec)s requiere una de: "
"%(supported)s."

#: pymedia/errors.py:165
#, python-format
msgid ""
"Invalid extension %(extension)s. %(media_type)s requires one of: "
"%(supported)s."
msgstr ""
"Extensión %(extension)s no válida. %(media_type)s requiere una de: "
"%(supported)s."

#: pymedia/errors.py:178
msgid "Invalid timestamp format. Expected: hh:mm:ss."
msgstr "Formato de marca de tiempo no válido. Esperado: hh:mm:ss."

#: pymedia/errors.py:184
#, python-format
msgid "Timestamp %(time)s exceeds video duration %(duration)s."
msgstr "La marca de tiempo %(time)s supera la duración del vídeo %(duration)s."

#: pymedia/typer_options.py:29 pymedia/typer_options.py:37
#, python-format
msgid "%(path)s is not a file."
msgstr "%(path)s no es un archivo."

#: pymedia/typer_options.py:49
msgid "Video to process."
msgstr "Vídeo a procesar."

#: pymedia/typer_options.py:57
msgid "Video list to process."
msgstr "Lista de vídeos a procesar."

#: pymedia/typer_options.py:72
msgid "Log level DEBUG"
msgstr "Nivel de log DEBUG"

#: pymedia/typer_options.py:81
msgid "Show this msg and exit."
msgstr "Muestra este mensaje y sale."

#: pymedia/typer_options.py:98 pymedia/typer_options.py:108
#: pymedia/typer_options.py:118
msgid "Output options"
msgstr "Opciones de salida"

#: pymedia/typer_options.py:99
msgid "Output directory for multiple output files."
msgstr "Directorio de salida para varios archivos de salida."

#: pymedia/typer_options.py:109
msgid "Output file name."
msgstr "Nombre del archivo de salida."

#: pymedia/typer_options.py:119
msgid "Action to use if output file already exists."
msgstr "Acción a usar si el archivo de salida ya existe."

#: pymedia/typer_options.py:134 pymedia/typer_options.py:143
#: pymedia/typer_options.py:152 pymedia/typer_options.py:163
