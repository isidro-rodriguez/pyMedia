msgid "FFmpeg command failed during execution."
msgstr "El comando FFmpeg falló durante la ejecución."

#: pymedia/commands/base_command.py:238 pymedia/commands/base_command.py:285
msgid "BasePipeline skipped since output file already exists."
msgstr "Comando omitido porque el archivo de salida ya existe."

