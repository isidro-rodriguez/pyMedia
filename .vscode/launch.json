{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Test: fichero actual",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "--no-cov",
                "-x",
                "-q"
            ],
            "justMyCode": false
        },
        {
            "name": "Test: el que tengo seleccionado",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-k",
                "${selectedText}",
                "--no-cov",
                "-q"
            ],
            "justMyCode": false
        },
        {
            "name": "pymedia: comando a mano",
            "type": "debugpy",
            "request": "launch",
            "module": "pymedia.main",
            "args": [
                "info",
                "${input:video}"
            ],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "video",
            "type": "promptString",
            "description": "Ruta del vídeo"
        }
    ]
}
