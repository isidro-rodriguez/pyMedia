{
  "base_command": "uv run pymedia gif ./.local/fixtures/vsrc_h265_720p.mp4 ",
  "variants": [
    {
      "name": "GIF DEFAULT",
      "args": "-o ./.local/qt/gif_default.gif"
    },
    {
      "name": "GIF CROP",
      "args": "-o ./.local/qt/gif_crop.gif -c 0,0,200,200"
    },
    {
      "name": "GIF END POINT",
      "args": "-o ./.local/qt/gif_end_point.gif -ep 4"
    },
    {
      "name": "GIF FPS",
      "args": "-o ./.local/qt/gif_fps.gif -f 4"
    },
    {
      "name": "GIF START POINT",
      "args": "-o ./.local/qt/gif_start_point.gif -sp 7"
    },
    {
      "name": "GIF GYRATE",
      "args": "-o ./.local/qt/gif_gyrate.gif -g 90"
    },
    {
      "name": "GIF SCALE",
      "args": "-o ./.local/qt/gif_scale.gif -s 240"
    },
    {
      "name": "GIF FULL",
      "args": "-o ./.local/qt/gif_full.gif -f 4 -s 240 -c 0,0,200,200 -sp 4 -ep 7 -g 90"
    }
  ]
}