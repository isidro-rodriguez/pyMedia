{
  "base_command": "uv run pymedia concat ./.local/fixtures/src_h265_720p.mp4 ./.local/fixtures/vsrc_h265_720p.mp4 ",
  "variants": [
    {
      "name": "CONCAT DEMUX",
      "args": "-o ./.local/qt/concat_compatible_demux.mp4"
    },
    {
      "name": "CONCAT GYRATE",
      "args": "-o ./.local/qt/concat_compatible_gyrate.mp4 -g 90"
    },
    {
      "name": "CONCAT SCALE",
      "args": "-o ./.local/qt/concat_compatible_scale.mp4 -s 480"
    },
    {
      "name": "CONCAT CROP",
      "args": "-o ./.local/qt/concat_compatible_crop.mp4 -c 0,0,100,100"
    },
    {
      "name": "CONCAT FULL",
      "args": "-o ./.local/qt/concat_compatible_full.mp4 -g 180 -s 480 -c 0,0,100,100"
    }
  ]
